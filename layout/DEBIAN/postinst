#!/bin/bash
# Dock 轮播 postinst
# 只做目录与权限准备，【不自动注销】——是否重启桌面交给用户自己决定。
DIR="/var/mobile/Documents/DockScroller"
mkdir -p "$DIR"
chmod 777 "$DIR"
chown mobile:mobile "$DIR" 2>/dev/null || true

# 首次安装给一份空配置，避免读到半截状态
if [ ! -f "$DIR/config.plist" ]; then
    printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict/></plist>\n' > "$DIR/config.plist"
    chmod 666 "$DIR/config.plist" 2>/dev/null || true
fi

echo ""
echo "Dock 轮播已安装。"
echo "生效方式二选一："
echo "  · 手动重启桌面（推荐，立即生效）"
echo "  · 什么都不做，下次重启设备后自动生效"
echo "卸载/禁用：在 $DIR 放一个名为 DISABLED 的空文件即可。"
echo ""

exit 0
